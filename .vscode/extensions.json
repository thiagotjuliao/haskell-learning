{
  "recommendations": [
    // Renders a diagnostic's message inline, at the end of the offending line,
    // instead of behind a hover or in the Problems panel. It produces no
    // diagnostics of its own — everything it draws comes from the language
    // server.
    "usernamehw.errorlens",

    // Sidebar panel rendering the documentation of the symbol under the cursor.
    "bierner.docs-view",

    // Colour-codes comment categories (`// !`, `// ?`, `// TODO`, `// *`), so a
    // TODO does not read like an ordinary note.
    "aaron-bond.better-comments",

    // Renders ```mermaid blocks in the Markdown preview, as GitHub does; the
    // built-in preview shows them as code. Design notes and theory documents
    // draw their state and sequence diagrams that way.
    "bierner.markdown-mermaid",

    // Haskell language server (HLS): types on hover, and fourmolu on save.
    "haskell.haskell",
  ]
}
